# Reloop 配置文件示例
# 复制为 reloop.yaml 并修改

driver:
  # Driver 类型: mock (测试) | flick (生产) | codex (OpenAI Codex CLI)
  type: flick

  # FlickDriver 配置（默认配置，executor 和 evaluator 共用的回退值）
  flick:
    # Duet Workspace ID 或路径（必需）
    # 可通过 `flick link workspace list` 查看
    workspace: "d2d9e0a8xxxxxxxxxxxxxxxxxxxxxxxx"
    # 或使用路径
    # workspace: "/path/to/project"

    # 可选：模型选择
    # 可选值: CLAUDE_4_5, CLAUDE_4_6, AUTO, 等
    model: "CLAUDE_4_5"

    # 可选：模式选择
    # 可选值: agent, plan, deep, discuss, ask
    mode: "agent"

    # 可选：JSON 输出（默认 true）
    # 启用后输出结构化 JSON，便于解析
    json_output: true

  # CodexDriver 配置（默认配置，executor 和 evaluator 共用的回退值）
  codex:
    # 可选：模型名称（不指定则使用 ~/.codex/config.toml 中的默认模型）
    # 可用模型（2026-05）:
    #   gpt-5.5               最新前沿模型（推荐）
    #   gpt-5.1-codex         Codex 专用模型
    #   gpt-5.1-codex-max     Codex Max 模型（更强）
    #   gpt-5-codex-mini      Codex Mini 模型（轻量快速）
    #   o3                    OpenAI o3 推理模型
    model: "gpt-5-codex-mini"

    # 可选：沙箱模式
    # 可选值: read-only, workspace-write, danger-full-access
    sandbox: "workspace-write"

    # 可选：完全自动运行（跳过所有确认提示）
    # 映射到 codex exec 的 --dangerously-bypass-approvals-and-sandbox
    full_auto: true

  # ===== Per-role 配置（可选）=====
  # executor 和 evaluator 可以使用不同的 driver 类型或不同的配置。
  # role-specific 配置会与上面的默认配置做深合并（role 的值覆盖默认值）。
  #
  # 示例 1：同类型 driver，不同模型
  #   executor:
  #     type: codex
  #     codex:
  #       model: gpt-5.1-codex        # executor 用更强的模型
  #   evaluator:
  #     type: codex
  #     codex:
  #       model: gpt-5-codex-mini      # evaluator 用轻量的模型
  #
  # 示例 2：不同类型 driver
  #   executor:
  #     type: codex                    # executor 用 Codex CLI
  #   evaluator:
  #     type: flick                    # evaluator 用 Flick
  #     flick:
  #       model: CLAUDE_4_5            # evaluator 用 Flick 的专属配置