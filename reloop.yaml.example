# Reloop 配置文件示例
# 复制为 reloop.yaml 并修改

driver:
  # Driver 类型: mock (测试) | flick (生产) | codex (OpenAI Codex CLI) | claudecode (Claude Code CLI) | cursor (Cursor Agent CLI)
  type: flick

  # FlickDriver 配置（默认配置，executor 和 evaluator 共用的回退值）
  flick:
    workspace: "d2d9e0a8xxxxxxxxxxxxxxxxxxxxxxxx"
    model: "CLAUDE_4_5"
    mode: "agent"
    json_output: true

  # CodexDriver 配置
  codex:
    # 可用模型（2026-05）: gpt-5.5, gpt-5.1-codex, gpt-5.1-codex-max, gpt-5-codex-mini, o3
    model: "gpt-5-codex-mini"
    sandbox: "workspace-write"
    full_auto: true

  # ClaudeCodeDriver 配置
  claudecode:
    # 可用模型（2026-05）: sonnet, opus, claude-sonnet-4-6, claude-opus-4
    model: "sonnet"
    # 权限模式（默认 bypassPermissions，全自动无人干预）
    # 可选值: bypassPermissions, auto, default, dontAsk, plan, acceptEdits
    permission_mode: "bypassPermissions"
    # max_budget_usd: 5.0
    # add_dirs:
    #   - "/path/to/other/project"

  # CursorDriver 配置（默认配置，executor 和 evaluator 共用的回退值）
  cursor:
    # 可用模型（2026-05，常用）: composer-2-fast(默认), composer-2, claude-4.6-sonnet-medium,
    #   claude-opus-4-7-xhigh, gpt-5.3-codex, auto
    model: "composer-2-fast"
    # 全自动参数（默认都开启，确保无人干预运行）
    yolo: true
    trust: true
    # sandbox: "disabled"  # 可选值: enabled, disabled

  # ===== Per-role 配置（可选）=====
  # executor、evaluator 和 checker 可以使用不同的 driver 类型或不同的配置。
  # role-specific 配置会与上面的默认配置做深合并（role 的值覆盖默认值）。
  #
  # 示例 1：同类型 driver，不同模型
  #   executor:
  #     type: cursor
  #     cursor:
  #       model: composer-2           # executor 用更强模型
  #   evaluator:
  #     type: cursor
  #     cursor:
  #       model: composer-2-fast      # evaluator 用默认快速模型
  #   checker:
  #     type: cursor
  #     cursor:
  #       model: composer-2-fast      # checker 用默认快速模型
  #
  # 示例 2：不同类型 driver
  #   executor:
  #     type: claudecode              # executor 用 Claude Code
  #     claudecode:
  #       model: opus
  #   evaluator:
  #     type: codex                   # evaluator 用 Codex
  #     codex:
  #       model: gpt-5-codex-mini
  #   checker:
  #     type: cursor                  # checker 用 Cursor
  #     cursor:
  #       model: composer-2-fast
  #
  # 示例 3：混合 driver
  #   executor:
  #     type: cursor                  # executor 用 Cursor
  #     cursor:
  #       model: composer-2-fast
  #   evaluator:
  #     type: claudecode              # evaluator 用 Claude Code
  #     claudecode:
  #       model: sonnet
  #   checker:
  #     type: flick                   # checker 用 Flick
  #     flick:
  #       model: CLAUDE_4_5